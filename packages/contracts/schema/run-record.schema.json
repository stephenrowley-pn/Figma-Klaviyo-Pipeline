    "rulesetVersion": {
      "type": "string",
      "minLength": 1
    },
    "transformVersion": {
      "type": "string",
      "minLength": 1
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "promptHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
