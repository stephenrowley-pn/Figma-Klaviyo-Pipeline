{
  "name": "figma-klaviyo-pipeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "schema:generate": "tsx packages/contracts/src/json-schema/generate.ts",
    "schema:check": "tsx scripts/check-schema-staleness.ts",
    "guard:protected-paths": "tsx scripts/guard-protected-paths.ts",
    "check:licenses": "tsx scripts/check-licenses.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
